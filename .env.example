# Variáveis lidas pelo docker-compose.dev.yaml da raiz. Copie para .env antes de rodar
# `docker compose -f docker-compose.dev.yaml up`. A GEMINI_API_KEY NÃO fica aqui: vai em
# apps/api/.env (só a API a lê; nunca vai para o frontend).

# Banco (Postgres 16). Os defaults batem com apps/api/.env.example.
DB_DATABASE=ai_test
DB_USERNAME=ai_test
DB_PASSWORD=ai_test

# Portas do host. Os defaults evitam colidir com o doit (8001, 5435, 3001) e o Hidro Vision
# (8000, 5434) rodando na mesma máquina.
APP_PORT=8002
DB_PORT=5436
WEB_PORT=3002

# Build das imagens em dev: usuário/UID dos containers, para bater com o dono dos arquivos
# em ./apps/* no host (bind mount). O bash exporta USER, mas não UID: sem `export UID` o
# build usa o default 1000.
# USER=
# UID=
